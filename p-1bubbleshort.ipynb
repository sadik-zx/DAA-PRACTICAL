      "cell_type": "code",
      "source": [
        "n = int(input(\"Enter size: \"))\n",
        "a = list(map(int, input(\"Enter elements: \").split()))\n",
        "\n",
        "for i in range(n):\n",
        "    for j in range(n-i-1):\n",
        "        if a[j] > a[j+1]:\n",
        "            a[j], a[j+1] = a[j+1], a[j]\n",
        "\n",
        "print(\"Sorted:\", a)"
      ],
