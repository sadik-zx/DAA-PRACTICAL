      "source": [
        "a = list(map(int, input(\"Enter elements: \").split()))\n",
        "key = int(input(\"Enter key: \"))\n",
        "\n",
        "for i in range(len(a)):\n",
        "    if a[i] == key:\n",
        "        print(\"Found at position:\", i+1)\n",
        "        break\n",
        "else:\n",
        "    print(\"Not Found\")"
      ],
